<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark variant: dark window background + light status bar icons for
         night mode. Compose (GoalHubTheme) draws the actual UI; these match
         the system-bar appearance before/around Compose content. -->
    <style name="Theme.GoalHub" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
